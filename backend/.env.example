# Environment variables for SmartTrans Ethiopia Backend
# Copy this file to .env and fill in your values.

# Supabase PostgreSQL connection string
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# JWT Configuration
JWT_SECRET_KEY=your_very_long_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - comma-separated origins, use * for development
CORS_ORIGINS=*

# App
APP_NAME=SmartTrans Ethiopia API
APP_VERSION=1.0.0
DEBUG=True
